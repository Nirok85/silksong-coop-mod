    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile production decisions directly. Program supplies deterministic API shims,
         so these checks do not replace Unity-engine or in-game physics verification. -->
